# Database
DATABASE_URL="postgresql://inventory:inventory_dev_password@localhost:5433/inventory_db?schema=public"

# App
PORT=4310
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Only set this to true in local development. With no email provider wired up,
# this exposes the password-reset token directly in the forgot-password API
# response so the flow is testable. Never set this in a real deployment.
EXPOSE_DEV_RESET_TOKEN=true

# Auth
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_for_access_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d

# Seed / bootstrap admin (development only - do not use in production)
SEED_ADMIN_EMAIL=admin@inventory.local
SEED_ADMIN_PASSWORD=Admin@12345
